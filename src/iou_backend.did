// IOU backend Candid interface.
// Hand-written to match src/lib.rs.
// Re-generate with `dfx generate iou_backend` to overwrite (the
// generated version will be byte-identical for the type signatures
// below).

type UserRecord = record {
    user_principal : principal;
    wrapped_display_name : vec nat8;
    display_name_iv : vec nat8;
    created_at : nat64;
    templates_enc : opt vec nat8;   // E2E-encrypted transaction templates
    templates_iv : opt vec nat8;
    // v1.12.0: the user's ONE default currency (ISO 4217, uppercase). Plaintext —
    // not PII, and only ever returned by get_my_user (caller-scoped).
    default_currency : opt text;
};

type AiAppVerificationBinding = record {
    user_index_canister_id : principal;
    app_id : nat32;
    app_revision : nat64;
    owner : principal;
    canonical_name : text;
    app_canister_id : principal;
    inbox_canister_id : opt principal;
    manifest_hash : blob;
};

type Config = record {
    creator_principal : principal;
    deployed_at : nat64;
    // v1.12.0: deployment-wide currency the app-rendered card pre-selects. ANONYMOUSLY
    // readable via get_config — the storage-partitioned card iframe has no identity.
    card_currency : opt text;
    // Exact OpenChat user-canister owner this deployment will vouch for.
    ai_app_owner : opt principal;
    // Exact OpenChat UserIndex trusted for link claims/card capabilities.
    openchat_user_index_canister_id : opt principal;
    // Exact reviewed OpenChat verifier-v2 registry/manifest commitment.
    ai_app_verification_binding : opt AiAppVerificationBinding;
};

// Generic OpenChat manifest-verification contract (app side): OpenChat c2c-calls this at publish to
// confirm we control the canister its manifest points at. We vouch for our own name only.
type VerifyAiAppArgs = record {
    name : text;
    owner : principal;
};

type VerifyAiAppResponse = record {
    vouched : bool;
    name : opt text;
    owner : opt principal;
};

type VerifyAiAppV2Args = record {
    binding : AiAppVerificationBinding;
};

type VerifyAiAppV2Response = record {
    vouched : bool;
    binding : AiAppVerificationBinding;
};

type AttestedActionCardRow = record {
    label : text;
    value : text;
};

type AiAppCardContentV1 = record {
    title : text;
    rows : vec AttestedActionCardRow;
    confirm_label : text;
    cancel_label : text;
    action_id : text;
    disclosure : opt text;
    expires_at : opt nat64;
    confirm_payload : opt blob;
};

type AppScopedCardContextV1 = record {
    context_version : nat16;
    app_subject : blob;
    chat_handle : blob;
    message_handle : blob;
    app_id : nat32;
    app_revision : nat64;
    action_id : text;
};

type AppScopedCardContentCommitmentV1 = record {
    context : AppScopedCardContextV1;
    content : AiAppCardContentV1;
};

type CardAttestationBindingV1 = record {
    user_index_canister_id : principal;
    app_canister_id : principal;
    commitment : AppScopedCardContentCommitmentV1;
    authority_content_hash : blob;
};

type AttestAiAppCardV1Args = record {
    binding : CardAttestationBindingV1;
};

type AttestAiAppCardV1Response = record {
    vouched : bool;
    binding : CardAttestationBindingV1;
};

type CardConfirmationAttestationBindingV1 = record {
    user_index_canister_id : principal;
    app_canister_id : principal;
    context : AppScopedCardContextV1;
    content_hash : blob;
    confirm_payload : blob;
    app_user_key_version : opt nat64;
};

type AttestAiAppCardConfirmationV1Args = record {
    binding : CardConfirmationAttestationBindingV1;
};

type AttestAiAppCardConfirmationV1Response = record {
    vouched : bool;
    binding : CardConfirmationAttestationBindingV1;
};

type Pair = record {
    id : text;
    members : vec principal;     // [creator, joiner | anonymous]
    invite_code : text;
    created_at : nat64;
    archived_at : opt nat64;
    name_enc : opt vec nat8;            // E2E-encrypted account name
    name_iv : opt vec nat8;
    member_a_name_enc : opt vec nat8;   // E2E-encrypted member_a display name
    member_a_name_iv : opt vec nat8;
    member_b_name_enc : opt vec nat8;   // E2E-encrypted member_b display name
    member_b_name_iv : opt vec nat8;
    // v1.12.0: per-member SHARED transaction-template blobs (AES-GCM under
    // the active sheet's K_sheet). Slot a = members[0], slot b = members[1].
    templates_a_enc : opt vec nat8;
    templates_a_iv : opt vec nat8;
    templates_b_enc : opt vec nat8;
    templates_b_iv : opt vec nat8;
};

type PairSummary = record {
    id : text;
    other_principal : principal;
    active_sheet_id : opt text;
    archived_sheet_count : nat32;
    created_at : nat64;
    archived_at : opt nat64;        // v1.10.0: account-level archive flag
    name_enc : opt vec nat8;        // E2E-encrypted account name
    name_iv : opt vec nat8;
    other_name_enc : opt vec nat8;  // the other member's encrypted name
    other_name_iv : opt vec nat8;
};

type SheetState = variant {
    Active;
    Closed;
};

type Sheet = record {
    id : text;
    pair_id : text;
    state : SheetState;
    closing_window_days : nat32;
    last_entry_at : opt nat64;
    wrapped_key_a : vec nat8;
    wrapped_key_b : vec nat8;
    member_a : principal;
    member_b : principal;
    created_at : nat64;
    closed_at : opt nat64;
    // AES-GCM balance snapshot encrypted client-side under K_sheet.
    closing_balances_key : opt vec nat8;
    closing_balances_enc : opt vec nat8;
    closing_balances_iv : opt vec nat8;
    name_enc : opt vec nat8;   // E2E-encrypted sheet name
    name_iv : opt vec nat8;
};

type CreatePairResult = record {
    pair_id : text;
    invite_code : text;
};

type CreateSheetReq = record {
    pair_id : text;
    closing_window_days : nat32;
    wrapped_key_a : vec nat8;
    wrapped_key_b : vec nat8;
    name_enc : opt vec nat8;   // optional E2E-encrypted sheet name at creation
    name_iv : opt vec nat8;
};

type EncryptedClosingBalances = record {
    entry_key : vec nat8;
    ciphertext : vec nat8;
    iv : vec nat8;
};

type EntryVersion = record {
    entry_key : vec nat8;
    ciphertext : vec nat8;
    iv : vec nat8;
    replaced_at : nat64;
};

type Entry = record {
    id : nat64;
    pair_id : text;
    sheet_id : text;
    created_by : principal;
    created_at_server : nat64;
    updated_at_server : opt nat64;
    entry_key : vec nat8;   // 32 random bytes (per-entry salt)
    ciphertext : vec nat8;  // AES-GCM(per_entry_key, K_sheet, payload)
    iv : vec nat8;
    history : opt vec EntryVersion;  // prior versions (edit history)
    deleted_at : opt nat64;          // soft-delete marker
};

type AddEntryReq = record {
    sheet_id : text;
    entry_key : vec nat8;
    ciphertext : vec nat8;
    iv : vec nat8;
};

type EditEntryReq = record {
    sheet_id : text;
    entry_id : nat64;
    entry_key : vec nat8;
    ciphertext : vec nat8;
    iv : vec nat8;
};

type ListEntriesResult = record {
    entries : vec Entry;
    next_cursor : opt nat64;
};

type ReplaceRequest = record {
    pair_id : text;
    leaving_principal : principal;
    new_principal : principal;
    ts_ms : nat64;
    nonce : vec nat8;
};

type SignedReplaceRequest = record {
    request : ReplaceRequest;
    signature : vec nat8;
    signer_pubkey : vec nat8;
};

// v1.3.0: principal-bound recovery key (V1 fix). The
// leaving member registers an Ed25519 pubkey once;
// submit_replace_member looks it up by `leaving_principal` and
// verifies the request signature against THAT key (not the
// caller-supplied `signer_pubkey`).
type RecoveryKey = record {
    owner : principal;
    ed25519_pubkey : vec nat8;
    registered_at : nat64;
};

// v1.3.0: nonce store for replace-member replay protection (V2).
// The (pair_id, nonce) pair is the unique identifier; we use a
// hex-encoded string key in the stable map.
type ConsumedNonce = record {
    pair_id : text;
    nonce : vec nat8;
    consumed_at : nat64;
};

// v1.4.0: solo sheets. One entry per still-active solo sheet being
// granted to a joined partner. wrapped_key_for_partner is K_sheet sealed
// to the partner's registered pubkey (dev), or empty (prod / vetkd).
type SheetRewrap = record {
    sheet_id : text;
    wrapped_key_for_partner : vec nat8;
};

// v1.8.0: OpenChat per-user consumer keypair. The canister stores an
// OPAQUE wrapped private-key blob (AES-GCM iv || ciphertext, wrapped
// client-side under the vetkd-derived user key) plus the matching P-256
// SPKI public key PEM. Caller-keyed; production web keeps plaintext only in
// session memory, native production may cache it in platform secure storage,
// and localStorage is development-only plus a one-time migration source.
type ConsumerKeypair = record {
    wrapped_private_key : vec nat8;
    public_key_pem : text;
};

// v1.14.0: canister-owned compare-and-swap state. mutation_epoch advances on
// every accepted set/delete; keypair = null at a non-zero epoch is a stable
// deletion tombstone which rejects delayed writes prepared at an older epoch.
type ConsumerKeypairState = record {
    mutation_epoch : nat64;
    keypair : opt ConsumerKeypair;
};

type ConsumerKeyEpochConflict = record {
    expected_epoch : nat64;
    current_epoch : nat64;
};

type ConsumerKeyMutationError = variant {
    StaleEpoch : ConsumerKeyEpochConflict;
    EpochExhausted;
    OpenChatBindingKeyMismatch;
};

type ConsumerKeyMutationResult = variant {
    Ok : nat64;
    Err : ConsumerKeyMutationError;
};

// OpenChat chat → sheet mapping. The stable field name remains chat_key for
// compatibility, but new rows use the app-scoped 32-byte chat handle encoded
// as unpadded base64url; raw chat principals/ids are never accepted as card
// context. sheet_id is the 16-hex-char sheet id encoded as a nat64. Caller-keyed.
type ChatSheetLink = record {
    chat_key : text;
    sheet_id : nat64;
};

type OpenChatBinding = record {
    iou_principal : principal;
    user_index_canister_id : principal;
    app_id : nat32;
    app_revision : nat64;
    app_canister_id : principal;
    key_version : nat64;
    // Caller-private, app-scoped identifiers issued by OpenChat's HMAC authority.
    app_subject : blob;
    subject_version : nat16;
    consumer_queue_selector : blob;
    consumer_queue_selector_version : nat16;
    linked_at : nat64;
};

type ConnectOpenChatResult = variant {
    Success : OpenChatBinding;
    NotConfigured;
    CodeNotFound;
    CodeExpired;
    InvalidRequest : text;
    WrongApp;
    RemoteError : text;
};

type DisconnectOpenChatResult = variant {
    Success;
    KeyNotFound;
    NotConfigured;
    NotLinked;
    InvalidBinding;
    InvalidRequest : text;
    BindingChanged;
    RemoteError : text;
};

type OpenChatCardContext = record {
    sheet_id : text;
    context_version : nat16;
    app_subject : blob;
    chat_handle : blob;
    message_handle : blob;
    app_id : nat32;
    app_revision : nat64;
    action_id : text;
    vetkd_public_key : vec nat8;
    encrypted_vet_key : vec nat8;
    templates_a_enc : opt vec nat8;
    templates_a_iv : opt vec nat8;
    templates_b_enc : opt vec nat8;
    templates_b_iv : opt vec nat8;
};

type OpenChatCardContextResult = variant {
    Success : OpenChatCardContext;
    NotConfigured;
    InvalidCapability;
    NotLinked;
    ChatNotLinked;
    NotAuthorized;
    KeyUnavailable;
};

service : {
    // Phase 1
    whoami : () -> (opt text) query;
    get_my_user : () -> (opt UserRecord) query;
    set_display_name : (vec nat8, vec nat8) -> (UserRecord);
    set_user_templates : (vec nat8, vec nat8) -> (UserRecord);
    set_default_currency : (text) -> (UserRecord);
    get_config : () -> (Config) query;
    set_creator_principal : (principal) -> ();
    set_ai_app_owner : (principal) -> ();
    set_openchat_user_index_canister_id : (principal) -> ();
    set_ai_app_verification_binding : (opt AiAppVerificationBinding) -> ();
    set_card_currency : (text) -> ();
    c2c_verify_ai_app : (VerifyAiAppArgs) -> (VerifyAiAppResponse) query;
    c2c_verify_ai_app_v2 : (VerifyAiAppV2Args) -> (VerifyAiAppV2Response) query;
    c2c_attest_ai_app_card_v1 : (AttestAiAppCardV1Args) -> (AttestAiAppCardV1Response);
    c2c_attest_ai_app_card_confirmation_v1 : (AttestAiAppCardConfirmationV1Args) -> (AttestAiAppCardConfirmationV1Response);

    // Phase 2
    create_pair : () -> (CreatePairResult);
    join_pair : (text) -> (text);
    // v1.10.0: invite-link auto-join + account lifecycle
    issue_invite : (text) -> (text);
  accept_invite : (text, vec SheetRewrap, vec nat8) -> (Pair);
    leave_pair : (text) -> (Pair);
    archive_pair : (text) -> (Pair);
    unarchive_pair : (text) -> (Pair);
    delete_pair : (text) -> ();
    get_my_pairs : () -> (vec PairSummary) query;
    get_pair : (text) -> (opt Pair) query;
    create_sheet : (CreateSheetReq) -> (Sheet);
    get_sheet : (text) -> (opt Sheet) query;
    get_sheet_wrapped_key : (text) -> (opt vec nat8) query;
    close_sheet_encrypted : (text, EncryptedClosingBalances) -> ();
    start_new_sheet : (CreateSheetReq) -> (Sheet);
    // v1.5.0: E2E-encrypted names
    set_pair_name : (text, vec nat8, vec nat8) -> ();
    set_sheet_name : (text, vec nat8, vec nat8) -> ();
    set_member_name : (text, vec nat8, vec nat8) -> ();
    // v1.12.0: shared transaction types per account — the caller's own
    // per-member slot only; both members read both slots via get_pair.
    set_pair_templates : (text, vec nat8, vec nat8) -> ();

    // Phase 3
    add_entry : (AddEntryReq) -> (Entry);
    edit_entry : (EditEntryReq) -> (Entry);
    delete_entry : (text, nat64) -> ();
    restore_entry : (text, nat64) -> ();
    get_entry : (text, nat64) -> (opt Entry) query;
    list_entries : (text, opt nat64, nat32) -> (ListEntriesResult) query;

    // Phase 4
    list_archived_sheets : (text) -> (vec Sheet) query;

    // v1.1.1: real vetkd
    get_vetkd_key_name : () -> (text) query;
    vetkd_public_key : () -> (vec nat8);
    vetkd_wrap_sheet_key : (text, vec nat8) -> (vec nat8);

    // v1.1.2: replace member
    submit_replace_member : (SignedReplaceRequest) -> (Pair);

    // v1.3.0: recovery key (V1 fix)
    register_recovery_pubkey : (vec nat8) -> ();
    get_recovery_pubkey : (principal) -> (opt vec nat8) query;

    // v1.4.0: solo sheets
    register_sheet_pubkey : (vec nat8) -> ();
    get_sheet_pubkey : (principal) -> (opt vec nat8) query;
    grant_partner_access : (text, principal, vec SheetRewrap) -> (nat32);

    // v1.8.0: OpenChat per-user consumer keypair
    set_consumer_keypair : (nat64, vec nat8, text) -> (ConsumerKeyMutationResult);
    get_consumer_keypair : () -> (ConsumerKeypairState) query;
    delete_consumer_keypair : (nat64) -> (ConsumerKeyMutationResult);
    vetkd_wrap_consumer_key : (vec nat8) -> (vec nat8);

    // v1.9.0: OpenChat chat → sheet mapping
    set_chat_sheet_link : (text, nat64) -> ();
    remove_chat_sheet_link : (text) -> ();
    chat_sheet_links : () -> (vec ChatSheetLink) query;

    // v1.15.0: authoritative OpenChat identity link and capability-gated,
    // ciphertext-only app-card context.
    connect_openchat : (text, text) -> (ConnectOpenChatResult);
    get_openchat_binding : () -> (opt OpenChatBinding) query;
    disconnect_openchat : (text, vec nat8, nat64) -> (DisconnectOpenChatResult);
    openchat_card_context : (vec nat8, text, vec nat8) -> (OpenChatCardContextResult);
}
