# Release signing for the Android app (v1.1.5).
#
# Copy this file to `android/keystore.properties` (gitignored) and fill in your
# real values. Generate a keystore once with:
#
#   keytool -genkey -v -keystore iou-release.jks -alias iou \
#           -keyalg RSA -keysize 2048 -validity 10000
#
# Then point storeFile at it (path relative to android/app/). Keep the .jks and
# this file OUT of git. Losing the key means you can never update the Play
# listing — back it up securely.

storeFile=../iou-release.jks
storePassword=CHANGE_ME
keyAlias=iou
keyPassword=CHANGE_ME
