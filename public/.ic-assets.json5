// Asset-canister response headers (served by iou_assets on IC + local).
// Explicit CSP tuned for this app: self-hosted fonts, React inline styles,
// the @dfinity/agent BLS wasm, and IC connectivity (local replica + mainnet).
//
// Framing posture — read before touching the document exceptions below:
//   Everything defaults to un-embeddable (`frame-ancestors 'none'` + `X-Frame-Options: DENY`).
//   The existing index.html exception lets the official OpenChat origin embed two declared
//   surfaces (see actionManifest.ts): the "card" surface (/openchat/card,
//   IOU's app-rendered confirmable card) and the "home" surface (/ , display:"sheet"). IOU is a
//   single-page app, so `/openchat/card`, `/`, and every other route are the SAME physical asset —
//   index.html — served via client-side routing. The asset canister matches these globs against
//   ASSET KEYS (physical files), never request paths, so a `/openchat/card` match would hit nothing;
//   a route-only rule would not isolate a framing permission from the rest of the SPA.
//   openchat/connect.html is therefore a separate physical document, with a connection-only
//   bootstrap. Only it additionally allows the APK helper at http://localhost:5193. That origin
//   is not proof of an APK identity; setup still requires bound requests and explicit consent.
//   Do not assume cross-origin frames are signed out: this setup page uses normal IOU auth.
//   Every other asset (JS/CSS/fonts/…) stays 'none'/DENY.
[
  {
    "match": "**/*",
    "headers": {
      "Content-Security-Policy": "default-src 'self'; connect-src 'self' http://127.0.0.1:40436 https://icp-api.io https://*.icp0.io https://*.ic0.app https://api.frankfurter.dev; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none';",
      "X-Content-Type-Options": "nosniff",
      // Required by the opaque-origin (`sandbox=allow-scripts`) OpenChat card frame. Static assets
      // are public and the frame is credentialless; this does not grant access to canister APIs.
      "Access-Control-Allow-Origin": "*",
      "X-Frame-Options": "DENY",
      "Referrer-Policy": "same-origin",
      "Permissions-Policy": "geolocation=(), microphone=(), camera=(), payment=()"
    },
    "disable_security_policy_warning": true
  },
  {
    // index.html only — the document OpenChat is allowed to frame. This entry comes AFTER `**/*`, so
    // its headers override the defaults for index.html (later match wins). The FULL header set is
    // re-declared (not just the two framing keys) so index.html keeps the same nosniff / Referrer /
    // Permissions hardening regardless of how the canister merges overlapping matches.
    //
    // Two framing changes vs. `**/*`:
    //   1. `frame-ancestors 'none'` → the OpenChat web origin allowlist (an allowlist DENIES every
    //      origin not listed, so this is still closed to the world — only OpenChat can frame IOU).
    //      Prod is https://oc.app. Add other real OpenChat deployment origins here as needed
    //      (e.g. https://test.oc.app, a fork's custom domain, or a local http://localhost:5003 /
    //      http://localhost:5001 when embedding a locally-deployed asset canister from local OpenChat).
    //   2. `X-Frame-Options` dropped to "" — XFO can only say DENY/SAMEORIGIN, never an allowlist, so a
    //      lingering DENY would veto the frame-ancestors allowlist in stricter/older engines. Empty is
    //      treated as absent, leaving CSP frame-ancestors as the sole (allowlist-capable) authority.
    "match": "index.html",
    "headers": {
      "Content-Security-Policy": "default-src 'self'; connect-src 'self' http://127.0.0.1:40436 https://icp-api.io https://*.icp0.io https://*.ic0.app https://api.frankfurter.dev; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors https://oc.app;",
      "X-Content-Type-Options": "nosniff",
      // Re-declared because this later index.html rule replaces the generic header set.
      "Access-Control-Allow-Origin": "*",
      "X-Frame-Options": "",
      "Referrer-Policy": "same-origin",
      "Permissions-Policy": "geolocation=(), microphone=(), camera=(), payment=()"
    },
    "disable_security_policy_warning": true
  },
  {
    // Physical connection entry only. No extensionless aliases and no index.html fallback here.
    // Keep the existing official web origin; add only the exact native Connect helper origin.
    "match": "openchat/connect.html",
    "enable_aliasing": false,
    "headers": {
      "Content-Security-Policy": "default-src 'self'; connect-src 'self' http://127.0.0.1:40436 https://icp-api.io https://*.icp0.io https://*.ic0.app https://api.frankfurter.dev; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors https://oc.app http://localhost:5193;",
      "X-Content-Type-Options": "nosniff",
      "Access-Control-Allow-Origin": "*",
      "X-Frame-Options": "",
      "Referrer-Policy": "same-origin",
      "Permissions-Policy": "geolocation=(), microphone=(), camera=(), payment=()"
    },
    "disable_security_policy_warning": true
  }
]
