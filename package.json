{
  "name": "iou",
  "version": "1.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "deploy:local": "dfx deploy iou_backend && pnpm build && dfx deploy iou_assets",
    "deploy:ic": "bash scripts/deploy-prod.sh",
    "cap:sync": "pnpm build && cap sync android",
    "cap:open:android": "cap open android",
    "cap:add:android": "cap add android",
    "android:build:debug": "cd android && ./gradlew assembleDebug",
    "android:install": "adb install -r android/app/build/outputs/apk/debug/app-debug.apk",
    "smoke": "pnpm exec tsx scripts/awa-smoke.ts",
    "smoke:vetkd": "pnpm exec tsx scripts/awa-smoke-vetkd.ts",
    "smoke:reset": "bash scripts/smoke-reset.sh",
    "test:unit": "vitest run",
    "postinstall": "node scripts/patch-vetkeys-esm.mjs"
  },
  "dependencies": {
    "@dfinity/agent": "^3.4.3",
    "@dfinity/auth-client": "^3.4.3",
    "@dfinity/candid": "^3.4.3",
    "@dfinity/identity": "^3.4.3",
    "@dfinity/identity-secp256k1": "^3.4.3",
    "@dfinity/principal": "^3.4.3",
    "@dfinity/vetkeys": "^0.4.0",
    "@noble/curves": "1.9.2",
    "@noble/hashes": "1.8.0",
    "@scure/bip39": "^2.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "qrcode": "^1.5.4",
    "@aparajita/capacitor-secure-storage": "^7.1.6",
    "@capacitor/core": "^7.6.0",
    "@capacitor/android": "^7.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.0",
    "@playwright/test": "^1.47.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^0.20.0",
    "vitest": "^2.0.0"
  }
}
