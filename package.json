{
  "name": "iou",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "audit:deps": "pnpm exec tsx scripts/security-audit.ts",
    "e2e": "playwright test",
    "deploy:local": "dfx deploy iou_backend && pnpm build && dfx deploy iou_assets && pnpm register:openchat",
    "deploy:ic": "bash scripts/deploy-prod.sh",
    "cap:sync": "pnpm build && cap sync android",
    "cap:open:android": "cap open android",
    "cap:add:android": "cap add android",
    "android:build:debug": "pnpm cap:sync && cd android && ./gradlew assembleDebug",
    "android:install": "adb install -r android/app/build/outputs/apk/debug/app-debug.apk",
    "smoke": "pnpm exec tsx scripts/awa-smoke.ts",
    "smoke:solo": "pnpm exec tsx scripts/awa-smoke-solo.ts",
    "smoke:vetkd": "pnpm exec tsx scripts/awa-smoke-vetkd.ts",
    "smoke:reset": "bash scripts/smoke-reset.sh",
    "test:unit": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:ui": "playwright test",
    "test:live:openchat:propose": "tsx scripts/live/verify-nomodel-guide.ts",
    "test:live:openchat:journey": "tsx scripts/live/journey-fanout.ts",
    "ui:demo": "tsx scripts/ui-multiuser-demo.ts",
    "mcp:serve": "pnpm exec tsx scripts/iou-mcp/server.ts",
    "mcp:selftest": "pnpm exec tsx scripts/iou-mcp/selftest.ts",
    "relay:serve": "pnpm exec tsx scripts/iou-relay/server.ts",
    "relay:selftest": "pnpm exec tsx scripts/iou-relay/selftest.ts",
    "relay:selftest:openchat": "pnpm exec tsx scripts/iou-relay/selftest-openchat.ts",
    "openchat:standin": "pnpm exec tsx scripts/iou-relay/openchat-standin.ts",
    "ocbot:serve": "pnpm exec tsx scripts/iou-openchat-bot/server.ts",
    "ocbot:selftest": "pnpm exec tsx scripts/iou-openchat-bot/selftest.ts",
    "register:openchat": "pnpm exec tsx scripts/register-openchat-app.ts",
    "deploy:inbox": "bash scripts/deploy-openchat-inbox.sh",
    "deploy:inbox:check": "bash scripts/deploy-openchat-inbox.sh --check",
    "deploy:inbox:upgrade": "bash scripts/deploy-openchat-inbox.sh --upgrade",
    "postinstall": "node scripts/patch-vetkeys-esm.mjs"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^7.1.6",
    "@capacitor/android": "^7.6.8",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.8",
    "@dfinity/agent": "^3.4.3",
    "@dfinity/auth-client": "^3.4.3",
    "@dfinity/candid": "^3.4.3",
    "@dfinity/identity": "^3.4.3",
    "@dfinity/identity-secp256k1": "^3.4.3",
    "@dfinity/principal": "^3.4.3",
    "@dfinity/vetkeys": "^0.4.0",
    "@noble/curves": "1.9.2",
    "@noble/hashes": "1.8.0",
    "@scure/bip39": "^2.2.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.8",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@playwright/test": "^1.62.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitest/coverage-v8": "^3.2.7",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7"
  }
}
